{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dubovyyhay",
  "compatibility_date": "2026-09-03",
  "main": "./worker.mjs",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    // 默认值；让 /zh、/zh/cookie-settings 这类无尾斜杠 URL 命中对应的 *.html 导出文件
    "html_handling": "auto-trailing-slash",
    // 未命中时返回 out/404.html（由 src/app/not-found.tsx 生成），保持自定义 404
    "not_found_handling": "404-page"
  }
}
